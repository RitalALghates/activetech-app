<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@drawable/bg_hero_flat"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/profileImageView"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/app_name"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_mark" />

            <TextView
                android:id="@+id/banner"
                style="@style/HeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text3"
                android:textSize="32sp" />

            <TextView
                style="@style/HeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Welcome back, sign in to continue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingTop="36dp"
            android:paddingRight="28dp"
            android:paddingBottom="24dp">

            <EditText
                android:id="@+id/email_Login"
                style="@style/AppInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/edit5"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/password_Login"
                style="@style/AppInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/edit6"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/ForgetPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:onClick="onForgotPasswordClick"
                android:text="@string/edit7"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/LogInBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:onClick="loginMethod"
                android:text="@string/text4" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/NewRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:minHeight="48dp"
                android:onClick="registerPage"
                android:text="@string/text5"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
